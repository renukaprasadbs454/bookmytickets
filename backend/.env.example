# Compose overrides DATABASE_URL, HOST, PORT and STORAGE_ROOT with container settings.
# Copy to .env and replace placeholders. Never commit .env.
DATABASE_URL=postgresql://bmt:CHANGE_ME@postgres:5432/bmt
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PORT=4100
HOST=0.0.0.0
PUBLIC_ORIGIN=http://127.0.0.1:4100
STORAGE_ROOT=/app/storage
NODE_ENV=development
# Optional providers; blank means unavailable / skipped. Razorpay TEST credentials only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Public HTTPS API origin, required for message links. Never expose local development publicly without hardening.
TICKET_PUBLIC_ORIGIN=

ADMIN_EMAIL=admin@bookmytickets.local
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_PASSWORD

STAFF_MFA_ENABLED=false
SEED_PARTNER_EMAIL=
SEED_PARTNER_PASSWORD=

# SMTP email OTP — fill with your mail provider credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Browser CORS allowlist; native APK uses bearer auth without Origin.
WEB_ORIGINS=https://user.bmt.kwiko.org,https://admin.bmt.kwiko.org,https://partner.bmt.kwiko.org,http://localhost:3000,http://localhost:5173,http://localhost:5178,http://localhost:5179,http://localhost:8081,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5178,http://127.0.0.1:5179,http://127.0.0.1:8081,http://127.0.0.1:19006

# Keep 0 for direct API access. VPS override sets 1 behind its sanitized gateway.
TRUST_PROXY_HOPS=0

# Android admin push (optional private Compose override; see deploy/PUSH-NOTIFICATIONS.md)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Temporary CUSTOMER login only: request a challenge, then use 123456 without SMS/SMTP.
# Disable after testing. Staff passwords are never bypassed.
CUSTOMER_OTP_TEST_MODE=false
# Optional comma-separated test emails / E.164 phone numbers; empty means all customers.
CUSTOMER_OTP_TEST_CONTACTS=
